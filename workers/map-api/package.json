{
  "name": "@topostack/map-api",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=/tmp/topostack-wrangler.log node --env-file-if-exists=../../.env ../../node_modules/wrangler/bin/wrangler.js dev --env development --port ${VITE_MAP_API_PORT:-8787} --local-upstream localhost:${VITE_MAP_API_PORT:-8787} --var PUBLIC_ORIGIN:http://localhost:${TOPOSTACK_WEB_PORT:-5273}",
    "build": "WRANGLER_LOG_PATH=/tmp/topostack-wrangler.log wrangler deploy --dry-run --env=\"\" --outdir dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "types": "WRANGLER_LOG_PATH=/tmp/topostack-wrangler.log wrangler types src/worker-configuration.d.ts --env-file .dev.vars.example",
    "types:check": "WRANGLER_LOG_PATH=/tmp/topostack-wrangler.log wrangler types src/worker-configuration.d.ts --env-file .dev.vars.example --check",
    "test": "WRANGLER_LOG_PATH=/tmp/topostack-wrangler-test.log vitest run",
    "coverage": "WRANGLER_LOG_PATH=/tmp/topostack-wrangler-test.log vitest run --coverage"
  },
  "devDependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260906.1",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@vitest/coverage-istanbul": "^4.1.11",
    "wrangler": "^4.143.1"
  }
}
