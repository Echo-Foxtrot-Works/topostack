{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "topostack-dev",
  "main": "src/index.ts",
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  // Core is consumed from source like the generator does; its package entry
  // points at a dist/ that CI never builds before testing or deploying. Only
  // the project subpath is aliased: the Worker never generates contours.
  "alias": { "@topostack/core/project": "../../packages/core/src/project/index.ts" },
  "assets": {
    "directory": "../../apps/generator/dist",
    // The MCP server reads the in-chat preview page (mcp-app/) through it.
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // The API, then the site pages that answer `Accept: text/markdown`
    // (src/routes/pages.ts matches the same paths). The studio and the build's
    // scripts, styles and data never reach the Worker.
    "run_worker_first": [
      "/health", "/ready", "/v1", "/v1/*", "/data/lake-outlines/*", "/mcp", "/.well-known/*",
      "/", "/guides", "/guides/*", "/examples", "/examples/*", "/lakes", "/lakes/*", "/lake/*", "/attribution", "/changelog", "/privacy"
    ]
  },
  "vars": {
    "ENVIRONMENT": "development",
    "ALLOWED_ORIGINS": "http://localhost:5273,http://127.0.0.1:5273,https://dev.topostack.app,https://dev-topostack.echofoxtrot.works,https://www.atomm.com",
    "ALLOWED_ORIGIN_SUFFIXES": ".atomm.com",
    "TERRAIN_ORIGIN": "https://s3.amazonaws.com/elevation-tiles-prod/terrarium",
    "GEOCODER_ORIGIN": "https://api.geoapify.com",
    "DATASET_VERSION": "mapzen-terrarium+protomaps-20260905-z12-v1",
    "FEEDBACK_EMAIL_FROM": "feedback@topostack.app",
    // Where the studio lives: agent links open it. `npm run dev` overrides it
    // with the local generator's port.
    "PUBLIC_ORIGIN": "http://localhost:5273"
  },
  // The top-level configuration is the fallback for a bare `wrangler deploy`
  // and for local tooling (tests, `--env=""` dry-run builds). It must never
  // point at production storage: bind the development buckets here so an
  // accidental bare deploy cannot write into production data.
  "r2_buckets": [
    { "binding": "MAP_CACHE", "bucket_name": "topostack-map-cache-development" },
    { "binding": "VECTOR_DATA", "bucket_name": "topostack-vector-data-development" }
  ],
  // Ratelimit bindings count per Cloudflare location. Shared (GLOBAL) budgets
  // sit at 10x the matching per-client budget so a few busy clients cannot
  // exhaust a feature for everyone else in a colo; they are abuse ceilings, not
  // spend control. The Geoapify dashboard's daily request cap is the real limit
  // on provider spend. Each limiter takes three consecutive namespace ids:
  // top-level, development, production.
  "ratelimits": [
    { "name": "REQUEST_LIMITER", "namespace_id": "1001", "simple": { "limit": 240, "period": 60 } },
    { "name": "GEOCODE_LIMITER", "namespace_id": "1004", "simple": { "limit": 30, "period": 60 } },
    { "name": "GEOCODE_GLOBAL_LIMITER", "namespace_id": "1007", "simple": { "limit": 300, "period": 60 } },
    { "name": "TERRAIN_GLOBAL_LIMITER", "namespace_id": "1010", "simple": { "limit": 2400, "period": 60 } },
    { "name": "FEEDBACK_LIMITER", "namespace_id": "1013", "simple": { "limit": 3, "period": 60 } },
    { "name": "FEEDBACK_GLOBAL_LIMITER", "namespace_id": "1016", "simple": { "limit": 30, "period": 60 } },
    { "name": "AGENT_LIMITER", "namespace_id": "1019", "simple": { "limit": 120, "period": 60 } },
    { "name": "AGENT_GLOBAL_LIMITER", "namespace_id": "1022", "simple": { "limit": 1200, "period": 60 } }
  ],
  // Feedback is emailed through Cloudflare Email Service. The sender domain
  // must be onboarded in the dashboard (Email Service > Onboard domain); the
  // recipient is the FEEDBACK_EMAIL_TO secret so it stays out of the repo.
  "send_email": [{ "name": "FEEDBACK_EMAIL" }],
  // head_sampling_rate stays at 1 because the line volume is controlled in the
  // Worker instead: src/request-log.ts samples the cache-hit request_completed
  // lines of the archive and terrain routes (hundreds per generation) and keeps
  // errors, cache misses and non-2xx statuses whole.
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  },
  "env": {
    "development": {
      "name": "topostack-dev",
      "triggers": { "crons": ["7 * * * *"] },
      "workers_dev": false,
      "preview_urls": false,
      // The first route is the canonical app. The legacy echofoxtrot.works
      // host stays attached only so published Atomm packages keep reaching the
      // API there: a zone Redirect Rule (scripts/configure-redirects.mjs)
      // sends every non-API request on it to the canonical host before the
      // Worker runs. CORS preflights cannot follow redirects, so the API is
      // served in place rather than redirected.
      "routes": [
        { "pattern": "dev.topostack.app", "custom_domain": true },
        { "pattern": "dev-topostack.echofoxtrot.works", "custom_domain": true }
      ],
      "vars": {
        "ENVIRONMENT": "development",
        "ALLOWED_ORIGINS": "http://localhost:5273,http://127.0.0.1:5273,https://dev.topostack.app,https://dev-topostack.echofoxtrot.works,https://www.atomm.com",
        "ALLOWED_ORIGIN_SUFFIXES": ".atomm.com",
        "TERRAIN_ORIGIN": "https://s3.amazonaws.com/elevation-tiles-prod/terrarium",
        "GEOCODER_ORIGIN": "https://api.geoapify.com",
        "DATASET_VERSION": "mapzen-terrarium+protomaps-20260905-z12-v1",
        "FEEDBACK_EMAIL_FROM": "feedback@topostack.app",
        "PUBLIC_ORIGIN": "https://dev.topostack.app"
      },
      "r2_buckets": [
        { "binding": "MAP_CACHE", "bucket_name": "topostack-map-cache-development" },
        { "binding": "VECTOR_DATA", "bucket_name": "topostack-vector-data-development", "remote": true }
      ],
      "secrets": { "required": ["GEOCODER_API_KEY", "FEEDBACK_EMAIL_TO"] },
      "ratelimits": [
        { "name": "REQUEST_LIMITER", "namespace_id": "1002", "simple": { "limit": 240, "period": 60 } },
        { "name": "GEOCODE_LIMITER", "namespace_id": "1005", "simple": { "limit": 30, "period": 60 } },
        { "name": "GEOCODE_GLOBAL_LIMITER", "namespace_id": "1008", "simple": { "limit": 300, "period": 60 } },
        { "name": "TERRAIN_GLOBAL_LIMITER", "namespace_id": "1011", "simple": { "limit": 2400, "period": 60 } },
        { "name": "FEEDBACK_LIMITER", "namespace_id": "1014", "simple": { "limit": 3, "period": 60 } },
        { "name": "FEEDBACK_GLOBAL_LIMITER", "namespace_id": "1017", "simple": { "limit": 30, "period": 60 } },
        { "name": "AGENT_LIMITER", "namespace_id": "1020", "simple": { "limit": 120, "period": 60 } },
        { "name": "AGENT_GLOBAL_LIMITER", "namespace_id": "1023", "simple": { "limit": 1200, "period": 60 } }
      ],
      "send_email": [{ "name": "FEEDBACK_EMAIL", "remote": true }]
    },
    "production": {
      "name": "topostack",
      "triggers": { "crons": ["7 * * * *"] },
      "workers_dev": false,
      "preview_urls": false,
      // See the development routes for why the legacy host stays attached.
      "routes": [
        { "pattern": "topostack.app", "custom_domain": true },
        { "pattern": "topostack.echofoxtrot.works", "custom_domain": true }
      ],
      "vars": {
        "ENVIRONMENT": "production",
        "ALLOWED_ORIGINS": "https://topostack.app,https://topostack.echofoxtrot.works,https://www.atomm.com",
        "ALLOWED_ORIGIN_SUFFIXES": ".atomm.com",
        "TERRAIN_ORIGIN": "https://s3.amazonaws.com/elevation-tiles-prod/terrarium",
        "GEOCODER_ORIGIN": "https://api.geoapify.com",
        "DATASET_VERSION": "mapzen-terrarium+protomaps-20260905-z12-v1",
        "FEEDBACK_EMAIL_FROM": "feedback@topostack.app",
        "PUBLIC_ORIGIN": "https://topostack.app"
      },
      "r2_buckets": [
        { "binding": "MAP_CACHE", "bucket_name": "topostack-map-cache" },
        { "binding": "VECTOR_DATA", "bucket_name": "topostack-vector-data" }
      ],
      "secrets": { "required": ["GEOCODER_API_KEY", "FEEDBACK_EMAIL_TO"] },
      "ratelimits": [
        { "name": "REQUEST_LIMITER", "namespace_id": "1003", "simple": { "limit": 240, "period": 60 } },
        { "name": "GEOCODE_LIMITER", "namespace_id": "1006", "simple": { "limit": 30, "period": 60 } },
        { "name": "GEOCODE_GLOBAL_LIMITER", "namespace_id": "1009", "simple": { "limit": 300, "period": 60 } },
        { "name": "TERRAIN_GLOBAL_LIMITER", "namespace_id": "1012", "simple": { "limit": 2400, "period": 60 } },
        { "name": "FEEDBACK_LIMITER", "namespace_id": "1015", "simple": { "limit": 3, "period": 60 } },
        { "name": "FEEDBACK_GLOBAL_LIMITER", "namespace_id": "1018", "simple": { "limit": 30, "period": 60 } },
        { "name": "AGENT_LIMITER", "namespace_id": "1021", "simple": { "limit": 120, "period": 60 } },
        { "name": "AGENT_GLOBAL_LIMITER", "namespace_id": "1024", "simple": { "limit": 1200, "period": 60 } }
      ],
      "send_email": [{ "name": "FEEDBACK_EMAIL", "remote": true }]
    }
  }
}
