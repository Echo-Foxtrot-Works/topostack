{
  "name": "@topostack/generator",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && vite build && node ../../scripts/build/finalize-static-headers.mjs && node ../../scripts/build/write-build-version.mjs",
    "build:e2e": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && vite build --mode e2e && node ../../scripts/build/finalize-static-headers.mjs && node ../../scripts/build/write-build-version.mjs",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run && vitest run --config vitest.client.config.ts",
    "coverage": "vitest run --coverage && vitest run --config vitest.client.config.ts --coverage",
    "preview": "vite preview"
  },
  "dependencies": {
    "@loidolt/theme-styles": "^0.4.0",
    "@loidolt/theme-svelte": "^0.4.0",
    "@lucide/svelte": "^1.45.0",
    "@mapbox/vector-tile": "^3.0.0",
    "@topostack/core": "*",
    "fflate": "^0.8.3",
    "idb-keyval": "^6.2.2",
    "maplibre-gl": "^6.9.0",
    "pbf": "^5.1.2",
    "pmtiles": "^4.5.0",
    "polygon-clipping": "^0.15.7",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/three": "^0.186.0",
    "@webgpu/types": "^0.1.69",
    "jsdom": "^30.0.1",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
